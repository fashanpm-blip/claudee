# === Обязательные ===
# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...
# Ваш Telegram ID (узнать: @userinfobot). Можно несколько через запятую
ADMIN_ID=123456789

# === База данных ===
# SQLite (по умолчанию, файл data/bot.db):
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# PostgreSQL (pip install asyncpg):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/expense_bot

# === Premium ===
# Цена подписки в Telegram Stars (100 ⭐ ≈ 2$)
PREMIUM_PRICE_STARS=100
TRIAL_DAYS=7
# Контакт поддержки для /paysupport (например, @my_support)
SUPPORT_CONTACT=

# Часовой пояс по умолчанию для новых пользователей
DEFAULT_TIMEZONE=Europe/Kyiv

# === ИИ (необязательно, без ключа работают встроенные алгоритмы) ===
# Claude: чеки, разбор голосовых фраз, недельный ИИ-анализ. Ключ: https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Распознавание речи (Whisper API, OpenAI-совместимый). Примеры:
# OpenAI: STT_BASE_URL=https://api.openai.com/v1  STT_MODEL=whisper-1
# Groq:   STT_BASE_URL=https://api.groq.com/openai/v1  STT_MODEL=whisper-large-v3
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
