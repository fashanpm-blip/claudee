---
import { t, type Lang } from '../i18n';
import { site } from '../site';

interface Props { lang: Lang; altPath: string; home: string }
const { lang, altPath, home } = Astro.props;
const s = t[lang];
const links = [
  ['#zeiten', s.nav.hours],
  ['#speisekarte', s.nav.menu],
  ['#galerie', s.nav.gallery],
  ['#events', s.nav.events],
  ['#catering', s.nav.catering],
  ['#kontakt', s.nav.contact],
] as const;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={home}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32"><circle cx="16" cy="16" r="15" fill="#2F5D45"/><path d="M16 6c-4 4-6 8-6 11a6 6 0 0 0 12 0c0-3-2-7-6-11Z" fill="#E9B45A"/><path d="M16 12v14" stroke="#1B2A22" stroke-width="1.6" stroke-linecap="round"/></svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">The Point</span>
        <span class="brand-sub">im Stadtpark Uerdingen</span>
      </span>
    </a>
    <nav class="main-nav" aria-label="Navigation">
      <ul>
        {links.map(([href, label]) => <li><a href={home + href}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="header-actions">
      <a class="lang" href={altPath} hreflang={lang === 'de' ? 'en' : 'de'} lang={lang === 'de' ? 'en' : 'de'}>
        {s.langSwitch.other}<span class="sr-only"> – {s.langSwitch.otherName}</span>
      </a>
      <a class="btn btn-gold reserve-top" href={site.phoneHref}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
        {s.reserve}
      </a>
    </div>
  </div>
</header>

<a class="reserve-sticky" href={site.phoneHref}>
  <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2Z"/></svg>
  <span>{s.reserve}</span>
  <span class="reserve-num">{site.phone}</span>
</a>
